# Скопируй в .env и заполни. Файл .env в git не попадает.

# --- LLM ---
# https://console.anthropic.com -> Settings -> API Keys
ANTHROPIC_API_KEY=
FRIDAY_MODEL=claude-sonnet-5-5
FRIDAY_MAX_TOKENS=1024
FRIDAY_MAX_HISTORY=30

# --- Пользователь ---
FRIDAY_USER_NAME=
# Как Пятница к тебе обращается: сэр, босс, по имени
FRIDAY_ADDRESS=сэр
# Приветствие голосом при запуске --voice
STARTUP_GREETING=1
# Пусто = таймзона берётся из местоположения дома
FRIDAY_TIMEZONE=
# Где хранить память, кеш местоположения и модели (вне репозитория)
FRIDAY_DATA_DIR=~/.friday

# --- Местоположение дома ---
# Пусто = определяется по IP при первом запуске и кешируется в FRIDAY_DATA_DIR/location.json.
# Заполни, только если IP показывает не тот город (например, под VPN).
HOME_LAT=
HOME_LON=
HOME_CITY=

# --- Home Assistant ---
HA_URL=http://localhost:8123
# Профиль в HA -> Security -> Long-lived access tokens
HA_TOKEN=
# Лампа по умолчанию, например light.room
FRIDAY_DEFAULT_LIGHT=

# --- Распознавание речи ---
STT_LANGUAGE=ru
# tiny / base / small / medium / large-v3 (больше = точнее и медленнее)
WHISPER_MODEL=small

# --- Wake word ---
# vosk (офлайн, без регистрации) | porcupine (точнее, нужен ключ Picovoice)
WAKE_ENGINE=vosk
WAKE_WORD=пятница
PORCUPINE_ACCESS_KEY=
PORCUPINE_KEYWORD_PATH=
# Для русского слова: путь к porcupine_params_ru.pv
PORCUPINE_MODEL_PATH=
PORCUPINE_SENSITIVITY=0.6

# --- Запись фразы ---
# Пауза, после которой фраза считается законченной
SILENCE_SECONDS=0.9
MAX_PHRASE_SECONDS=15
# Сколько ждать продолжения разговора без повторного wake word (0 = выключить)
FOLLOWUP_SECONDS=4
# Звуковой сигнал при срабатывании wake word
CHIME=1
# Задержка звука до колонки, сек. Пусто = авто: 2 для HomePod/AirPlay, 0.3 для динамиков мака.
# Если Пятница отвечает сама себе, увеличь.
OUTPUT_LATENCY=

# --- Поиск в интернете ---
# Встроенный поиск Anthropic: отдельный ключ не нужен, $10 за 1000 поисков.
# Должен быть включён для организации в консоли Anthropic, иначе Пятница продолжит без поиска.
WEB_SEARCH=1
# Сколько поисков модель может сделать на один вопрос
WEB_SEARCH_MAX_USES=3
WEB_SEARCH_TOOL=web_search_20260318

# --- Напоминания ---
# Как часто проверять, не пора ли напомнить, сек
REMINDER_CHECK_SECONDS=10
# Дублировать разовые напоминания в Apple «Напоминания» (появятся на iPhone).
# Имя списка, например Пятница. Пусто = выключено
APPLE_REMINDERS_LIST=

# --- Синтез речи ---
# say (системный) | silero (локально, pip install -e ".[silero]") | elevenlabs
TTS_ENGINE=say
TTS_VOICE=Milena
TTS_RATE=190
# xenia | baya | kseniya
SILERO_SPEAKER=xenia
# https://elevenlabs.io -> профиль -> API Keys
ELEVENLABS_API_KEY=
# Voices -> голос -> Copy Voice ID
ELEVENLABS_VOICE_ID=
# eleven_v4_turbo: новейшая модель для ассистентов, ~100 мс (если недоступна на тарифе, сработает откат)
# eleven_multilingual_v2: стабильная, хорошая русская интонация, медленнее
# eleven_flash_v2_5: самая быстрая, но интонация площе
ELEVENLABS_MODEL=eleven_v4_turbo
# 0..1: ниже = живее и эмоциональнее, выше = ровнее. Для ассистента 0.4-0.6
ELEVENLABS_STABILITY=0.5
# 0..1: близость к исходному тембру
ELEVENLABS_SIMILARITY=0.75
# 0..1: усиление манеры речи, повышает задержку. Обычно 0
ELEVENLABS_STYLE=0
# 0.7..1.2: скорость речи
ELEVENLABS_SPEED=1.0
ELEVENLABS_SPEAKER_BOOST=1
# acute: передавать ударения из словаря знаком ударения | none: не передавать
ELEVENLABS_STRESS=acute
