# Скопируй в .env и заполни. Файл .env в git не попадает.

# --- LLM ---
# https://console.anthropic.com -> Settings -> API Keys
ANTHROPIC_API_KEY=
FRIDAY_MODEL=claude-sonnet-5-5
FRIDAY_MAX_TOKENS=1024
FRIDAY_MAX_HISTORY=30

# --- Пользователь ---
FRIDAY_USER_NAME=
# Пусто = таймзона берётся из местоположения дома
FRIDAY_TIMEZONE=
# Где хранить память, кеш местоположения и модели (вне репозитория)
FRIDAY_DATA_DIR=~/.friday

# --- Местоположение дома ---
# Пусто = определяется по IP при первом запуске и кешируется в FRIDAY_DATA_DIR/location.json.
# Заполни, только если IP показывает не тот город (например, под VPN).
HOME_LAT=
HOME_LON=
HOME_CITY=

# --- Home Assistant ---
HA_URL=http://localhost:8123
# Профиль в HA -> Security -> Long-lived access tokens
HA_TOKEN=
# Лампа по умолчанию, например light.room
FRIDAY_DEFAULT_LIGHT=

# --- Распознавание речи ---
STT_LANGUAGE=ru
# tiny / base / small / medium / large-v3 (больше = точнее и медленнее)
WHISPER_MODEL=small

# --- Wake word ---
# vosk (офлайн, без регистрации) | porcupine (точнее, нужен ключ Picovoice)
WAKE_ENGINE=vosk
WAKE_WORD=пятница
PORCUPINE_ACCESS_KEY=
PORCUPINE_KEYWORD_PATH=
# Для русского слова: путь к porcupine_params_ru.pv
PORCUPINE_MODEL_PATH=
PORCUPINE_SENSITIVITY=0.6

# --- Запись фразы ---
# Пауза, после которой фраза считается законченной
SILENCE_SECONDS=0.9
MAX_PHRASE_SECONDS=15
# Сколько ждать продолжения разговора без повторного wake word (0 = выключить)
FOLLOWUP_SECONDS=4
# Звуковой сигнал при срабатывании wake word
CHIME=1

# --- Синтез речи ---
# say (системный) | silero (локально, pip install -e ".[silero]") | elevenlabs
TTS_ENGINE=say
TTS_VOICE=Milena
TTS_RATE=190
# xenia | baya | kseniya
SILERO_SPEAKER=xenia
# https://elevenlabs.io -> профиль -> API Keys
ELEVENLABS_API_KEY=
# Voices -> голос -> Copy Voice ID
ELEVENLABS_VOICE_ID=
# eleven_flash_v2_5 (быстро) | eleven_multilingual_v2 (качественнее, медленнее)
ELEVENLABS_MODEL=eleven_flash_v2_5
