# Скопируй в .env и заполни. Файл .env в git не попадает.

# --- LLM ---
ANTHROPIC_API_KEY=
FRIDAY_MODEL=claude-sonnet-5-5
FRIDAY_MAX_TOKENS=1024
FRIDAY_MAX_HISTORY=30

# --- Пользователь ---
FRIDAY_USER_NAME=
# IANA таймзона, например Europe/Berlin
FRIDAY_TIMEZONE=UTC
# Где хранить память ассистента (вне репозитория)
FRIDAY_DATA_DIR=~/.friday

# --- Home Assistant ---
HA_URL=http://localhost:8123
# Профиль в HA -> Security -> Long-lived access tokens
HA_TOKEN=
# Лампа по умолчанию, например light.room
FRIDAY_DEFAULT_LIGHT=

# --- Погода (open-meteo, ключ не нужен) ---
WEATHER_LAT=
WEATHER_LON=

# --- Голос ---
STT_LANGUAGE=ru
# tiny / base / small / medium / large-v3
WHISPER_MODEL=small
# Список голосов: say -v '?'
TTS_VOICE=Milena
TTS_RATE=190
